# .env.example — Variables de entorno (copia a .env). NUNCA subir .env a git.
# Todas son opcionales: si faltan se usa config.yaml.

# --- Wallet ----------------------------------------------------------
# Modo solo-pubkey (recomendado en la UNO Q): no hay clave privada en la placa.
MERCHANT_PUBKEY=5FMSn5BqmnxcZjf7K84PU4bpKhuFoioZQhoA5qSQs56M
# Modo keypair (opcional, permite crear ATA / refunds). Fuera de git.
# WALLET_PATH=wallet.json

# --- Red Solana ------------------------------------------------------
# Producción (mainnet). Para pruebas en devnet descomenta el bloque devnet.
RPC_HTTP=https://api.mainnet-beta.solana.com
RPC_WS=wss://api.mainnet-beta.solana.com
RPC_HTTP_BACKUP=https://api.mainnet-beta.solana.com
# NETWORK=devnet
# RPC_HTTP=https://api.devnet.solana.com
# RPC_WS=wss://api.devnet.solana.com
# RPC_HTTP_BACKUP=https://api.devnet.solana.com
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Dispensador -----------------------------------------------------
# DISPENSE_PIN=7
# DISPENSER_MODE=auto          # auto | unoq | gpiozero | stub
# DISPENSE_PULSE_SECONDS=2.5
# RELAY_ACTIVE_HIGH=true
# MCU_HOST=127.0.0.1
# MCU_PORT=7500
# MCU_TIMEOUT_MS=2000

# --- Servicio --------------------------------------------------------
# HTTP_PORT=8000

# Token para el endpoint manual /api/test/dispense (vacío = deshabilitado).
TEST_TOKEN=
